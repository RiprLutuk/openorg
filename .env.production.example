# ==============================================================================
# OpenOrg - Production Environment Variables Template
# Copy to .env.production on your VPS: cp .env.production.example .env.production
# ==============================================================================

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=openorg
POSTGRES_USER=openorg
POSTGRES_PASSWORD=generate-a-strong-random-password-here

# Domains & Public Routing (Point DNS A/AAAA records to your VPS IP)
WEB_DOMAIN=org.example.com
CMS_DOMAIN=cms.example.com
API_DOMAIN=api.example.com

# SSL Certificate Automated Issuance (Let's Encrypt via Caddy)
TLS_EMAIL=admin@example.com

# Security & Session Secrets (Must be at least 32 random characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=generate-a-strong-32-char-random-secret-key

# Single-Tenant Organization Configuration
DEFAULT_ORGANIZATION_SLUG=default

# Cookie Names
SESSION_COOKIE_NAME=openorg_session
MEMBER_SESSION_COOKIE_NAME=openorg_member_session

# Optional Initial Seed Admin (Only used if running bun run db:seed explicitly)
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=change-this-ultra-strong-password

# WhatsApp Notifications via WAHA (WhatsApp HTTP API - devlikeapro/waha)
# Optional: Set to enable automated WhatsApp delivery of KTA Digital and Email Verification links
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Transactional Email via Resend API (Recommended - https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=APTI Indonesia <onboarding@resend.dev>

# Alternative: Standard SMTP Email Dispatch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=APTI Indonesia <no-reply@apti.or.id>
